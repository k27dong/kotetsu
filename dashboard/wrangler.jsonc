{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotetsu",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "build": { "command": "pnpm build", "watch_dir": "web" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kotetsu",
      "database_id": "e618cc5b-48c9-45f0-b791-fbabb63ac2bd",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [{ "pattern": "kotetsu.k27dong.com", "custom_domain": true }],
}
