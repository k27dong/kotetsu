{
  "name": "kotetsu-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "wrangler dev",
    "build": "rm -rf dist && esbuild web/main.ts web/style.css --bundle --format=esm --target=es2022 --minify --sourcemap --outdir=dist && cp web/index.html dist/",
    "check": "tsc --noEmit && tsc --noEmit -p web && prettier --check ."
  },
  "prettier": {
    "printWidth": 100
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  },
  "dependencies": {
    "lunar-javascript": "1.7.7",
    "ts-pattern": "5.9.2"
  }
}
