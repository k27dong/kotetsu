[Unit]
Description=kotetsu e-paper screen
# Comitup's callback writes into /run/kotetsu, which exists only once this service has started
Before=comitup.service

[Service]
User=kotetsu
SupplementaryGroups=gpio spi
LoadCredential=pi-key:/etc/kotetsu/pi-key
RuntimeDirectory=kotetsu
# Comitup reports each Wi-Fi state once, so a restart must not delete the last one
RuntimeDirectoryPreserve=yes
StateDirectory=kotetsu
Environment=TZ=Europe/Warsaw
# No PrivateDevices=, ProtectClock= or ProcSubset=pid: they would hide spidev, gpiochip or /proc/net/wireless
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ExecStart=/usr/local/bin/kotetsu
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
